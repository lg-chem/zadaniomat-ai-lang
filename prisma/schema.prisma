generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  periods       Period[]
  categories    Category[]
  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  challenges    Challenge[]
  gamification  Gamification?
  backlogItems  BacklogItem[]
  aiConversations AIConversation[]
  settings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== SETTINGS ====================

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  defaultWorkspace      WorkspaceType @default(WORK)
  defaultSprintDuration Int      @default(14) // days
  defaultPeriodDuration Int      @default(90) // days
  workDayStart          String   @default("09:00")
  workDayEnd            String   @default("17:00")
  taskStatuses          Json     @default("[\"TODO\", \"IN_PROGRESS\", \"DONE\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== CORE ====================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum WorkspaceType {
  WORK
  PRIVATE
}

enum TaskStatus {
  NEW           // Nowe
  IN_PROGRESS   // Rozpoczęte
  COMPLETED     // Zakończone
  CANCELLED     // Anulowane
  TO_TRANSFER   // Do przeniesienia
}

// ==================== PERIODS & SPRINTS ====================

model Period {
  id            String        @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  workspaceType WorkspaceType
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sprints       Sprint[]
  goals         Goal[]        @relation("PeriodGoals")

  @@index([userId, workspaceType])
}

model Sprint {
  id            String        @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  periodId      String
  period        Period        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  goals         Goal[]        @relation("SprintGoals")
  tasks         Task[]
  retrospective Retrospective?

  @@index([periodId])
}

model Retrospective {
  id           String   @id @default(cuid())
  sprintId     String   @unique
  wentWell     String[] // What went well
  needsImprovement String[] // What needs improvement
  actionItems  String[] // Action items for next sprint
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

// ==================== CATEGORIES ====================

model Category {
  id            String        @id @default(cuid())
  name          String
  color         String        @default("#6366f1")
  icon          String?
  isStrategic   Boolean       @default(false)
  workspaceType WorkspaceType
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  goals         Goal[]
  habits        Habit[]

  @@unique([userId, name, workspaceType])
  @@index([userId, workspaceType])
}

// ==================== GOALS ====================

model Goal {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  targetValue   Float?        // For measurable goals
  currentValue  Float         @default(0)
  unit          String?       // e.g., "tasks", "hours", "%"
  isCompleted   Boolean       @default(false)
  workspaceType WorkspaceType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  periodId      String?
  period        Period?       @relation("PeriodGoals", fields: [periodId], references: [id], onDelete: SetNull)
  sprintId      String?
  sprint        Sprint?       @relation("SprintGoals", fields: [sprintId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([userId, workspaceType])
  @@index([periodId])
  @@index([sprintId])
}

// ==================== TASKS ====================

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?       @db.Text
  status         TaskStatus    @default(NEW)
  priority       Int           @default(0) // 0-3: none, low, medium, high
  plannedMinutes Int?
  actualMinutes  Int           @default(0)
  scheduledDate  DateTime?     @db.Date
  scheduledTime  String?       // HH:mm format
  orderInDay     Int           @default(0)
  isRecurring    Boolean       @default(false)
  recurrenceRule String?       // RRULE format
  workspaceType  WorkspaceType
  metadata       Json?         // For future extensions
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sprintId       String?
  sprint         Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  goalId         String?
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parentTaskId   String?
  parentTask     Task?         @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks       Task[]        @relation("SubTasks")
  timeEntries    TimeEntry[]

  @@index([userId, workspaceType])
  @@index([scheduledDate])
  @@index([sprintId])
  @@index([categoryId])
}

model TimeEntry {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutes
  notes       String?
  createdAt   DateTime  @default(now())

  // Relations
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ==================== HABITS & CHALLENGES (PRIVATE) ====================

model Habit {
  id            String        @id @default(cuid())
  name          String
  description   String?
  frequency     HabitFrequency @default(DAILY)
  targetCount   Int           @default(1) // Times per frequency
  color         String        @default("#10b981")
  icon          String?
  currentStreak Int           @default(0)
  longestStreak Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completions   HabitCompletion[]

  @@index([userId])
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model HabitCompletion {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  count       Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model Challenge {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  startDate     DateTime
  endDate       DateTime
  targetValue   Float
  currentValue  Float          @default(0)
  unit          String         // e.g., "days", "km", "sessions"
  isCompleted   Boolean        @default(false)
  color         String         @default("#f59e0b")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    ChallengeMilestone[]
  entries       ChallengeEntry[]

  @@index([userId])
}

model ChallengeMilestone {
  id          String   @id @default(cuid())
  name        String
  targetValue Float
  isReached   Boolean  @default(false)
  reachedAt   DateTime?

  // Relations
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  value       Float
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, date])
}

// ==================== GAMIFICATION ====================

model Gamification {
  id           String   @id @default(cuid())
  userId       String   @unique
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements UserAchievement[]
  rewards      UserReward[]
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String?
  xpReward    Int      @default(0)
  condition   Json     // Condition to unlock (flexible structure)
  createdAt   DateTime @default(now())

  // Relations
  users       UserAchievement[]
}

model UserAchievement {
  id             String   @id @default(cuid())
  unlockedAt     DateTime @default(now())

  // Relations
  gamificationId String
  gamification   Gamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)
  achievementId  String
  achievement    Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([gamificationId, achievementId])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  xpCost      Int
  icon        String?
  createdAt   DateTime @default(now())

  // Relations
  users       UserReward[]
}

model UserReward {
  id             String   @id @default(cuid())
  redeemedAt     DateTime @default(now())

  // Relations
  gamificationId String
  gamification   Gamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)
  rewardId       String
  reward         Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

// ==================== BACKLOG ====================

model BacklogItem {
  id            String        @id @default(cuid())
  content       String
  workspaceType WorkspaceType
  priority      Int           @default(0)
  isProcessed   Boolean       @default(false)
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceType, isProcessed])
}

// ==================== AI ====================

model AIConversation {
  id            String              @id @default(cuid())
  type          AIConversationType
  workspaceType WorkspaceType
  summary       String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AIMessage[]

  @@index([userId, type])
}

enum AIConversationType {
  MORNING_ROUTINE
  PLANNING
  RETROSPECTIVE
  GENERAL
}

model AIMessage {
  id             String   @id @default(cuid())
  role           String   // "user" or "assistant"
  content        String   @db.Text
  contextSnapshot Json?   // Snapshot of context at message time
  createdAt      DateTime @default(now())

  // Relations
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
