generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  isApproved    Boolean   @default(false) // Requires admin approval
  restrictedToWork Boolean @default(false) // If true, user can only see WORK workspace
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  periods       Period[]
  categories    Category[]
  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  challenges    Challenge[]
  groupChallengeMembers GroupChallengeMember[]
  groupChallengeInvitations GroupChallengeInvitation[]
  createdGroupChallenges GroupChallenge[]
  groupChallengeMessages GroupChallengeMessage[]
  gamification  Gamification?
  backlogItems  BacklogItem[]
  aiConversations AIConversation[]
  aiKnowledgeBases AIKnowledgeBase[]
  knowledgeCategories KnowledgeCategory[]
  knowledgeEntries KnowledgeEntry[]
  settings      UserSettings?
  sportActivityTypes SportActivityType[]
  sportActivities SportActivity[]
  stepsEntries  StepsEntry[]
  fitnessGoals  FitnessGoal[]
  adminReports  AdminReport[]
  weeklyScheduleBlocks WeeklyScheduleBlock[]
  dailyScheduleOverrides DailyScheduleOverride[]

  // Organization relations
  ownedOrganizations    Organization[]       @relation("OwnedOrganizations")
  organizationMemberships OrganizationMember[] @relation("OrganizationMemberships")
  assignedTasks         Task[]               @relation("AssignedTasks")
  notifications         Notification[]       @relation("ReceivedNotifications")
  teamMessages          TeamMessage[]        @relation("TeamMessages")
  ideas                 Idea[]
  ideaReplies           IdeaReply[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== SETTINGS ====================

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  defaultWorkspace      WorkspaceType @default(WORK)
  defaultSprintDuration Int      @default(14) // days
  defaultPeriodDuration Int      @default(90) // days
  workDayStart          String   @default("09:00")
  workDayEnd            String   @default("17:00")
  taskStatuses          Json     @default("[\"TODO\", \"IN_PROGRESS\", \"DONE\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== CORE ====================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum WorkspaceType {
  WORK
  PRIVATE
}

enum KnowledgeVisibility {
  PRIVATE   // Only visible to owner
  TEAM      // Visible to team members (if category is linked to team category)
}

enum TaskStatus {
  NEW           // Nowe
  IN_PROGRESS   // Rozpoczęte
  COMPLETED     // Zakończone
  CANCELLED     // Anulowane
  TO_TRANSFER   // Do przeniesienia
}

// ==================== PERIODS & SPRINTS ====================

model Period {
  id            String        @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  workspaceType WorkspaceType
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sprints       Sprint[]
  goals         Goal[]        @relation("PeriodGoals")
  fitnessGoals  FitnessGoal[]

  @@index([userId, workspaceType])
}

model Sprint {
  id            String        @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  periodId      String
  period        Period        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  goals         Goal[]        @relation("SprintGoals")
  tasks         Task[]
  retrospective Retrospective?

  @@index([periodId])
}

model Retrospective {
  id           String   @id @default(cuid())
  sprintId     String   @unique
  wentWell     String[] // What went well
  needsImprovement String[] // What needs improvement
  actionItems  String[] // Action items for next sprint
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

// ==================== CATEGORIES ====================

model Category {
  id            String        @id @default(cuid())
  name          String
  color         String        @default("#6366f1")
  icon          String?
  isStrategic   Boolean       @default(false)
  workspaceType WorkspaceType
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  knowledgeCategories KnowledgeCategory[]
  ideaCategories IdeaCategory[] @relation("LinkedIdeaCategories")

  // Organization (team) category - null means personal category
  organizationId String?
  organization   Organization? @relation("OrganizationCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  assignedMembers OrganizationMemberCategory[] @relation("AssignedMemberCategories")

  @@unique([userId, name, workspaceType])
  @@index([userId, workspaceType])
  @@index([organizationId])
}

// ==================== GOALS ====================

model Goal {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  targetValue   Float?        // For measurable goals
  currentValue  Float         @default(0)
  unit          String?       // e.g., "tasks", "hours", "%"
  isCompleted   Boolean       @default(false)
  workspaceType WorkspaceType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  periodId      String?
  period        Period?       @relation("PeriodGoals", fields: [periodId], references: [id], onDelete: SetNull)
  sprintId      String?
  sprint        Sprint?       @relation("SprintGoals", fields: [sprintId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([userId, workspaceType])
  @@index([periodId])
  @@index([sprintId])
}

// ==================== TASKS ====================

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?       @db.Text
  status         TaskStatus    @default(NEW)
  priority       Int           @default(0) // 0-3: none, low, medium, high
  plannedMinutes Int?
  actualMinutes  Int           @default(0)
  scheduledDate  DateTime?     @db.Date
  scheduledTime  String?       // HH:mm format
  orderInDay     Int           @default(0)
  isRecurring    Boolean       @default(false)
  recurrenceRule String?       // RRULE format
  workspaceType  WorkspaceType
  metadata       Json?         // For future extensions
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  userId         String        // Task creator/owner
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sprintId       String?
  sprint         Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  goalId         String?
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parentTaskId   String?
  parentTask     Task?         @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks       Task[]        @relation("SubTasks")
  timeEntries    TimeEntry[]

  // Task assignment (for team tasks)
  assignedToId   String?       // User assigned to complete this task
  assignedTo     User?         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  organizationId String?       // Organization this task belongs to
  organization   Organization? @relation("OrganizationTasks", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceType])
  @@index([scheduledDate])
  @@index([sprintId])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([organizationId])
}

model TimeEntry {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutes
  notes       String?
  createdAt   DateTime  @default(now())

  // Relations
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ==================== HABITS & CHALLENGES (PRIVATE) ====================

model Habit {
  id            String        @id @default(cuid())
  name          String
  description   String?
  frequency     HabitFrequency @default(DAILY)
  targetCount   Int           @default(1) // Times per frequency
  defaultMinutes Int?          // Default time for this habit
  color         String        @default("#10b981")
  icon          String?
  currentStreak Int           @default(0)
  longestStreak Int           @default(0)
  isActive      Boolean       @default(true)
  isPublic      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completions   HabitCompletion[]

  @@index([userId])
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model HabitCompletion {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  count       Int      @default(1)
  minutes     Int?     // Time spent on habit
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model Challenge {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  challengeType ChallengeType  @default(NUMERIC)
  startDate     DateTime
  endDate       DateTime
  targetValue   Float
  currentValue  Float          @default(0)
  unit          String         // e.g., "days", "km", "sessions"
  weeklyTarget  Int?           // For WEEKLY_HABIT: number of days per week
  isCompleted   Boolean        @default(false)
  isPublic      Boolean        @default(false)
  color         String         @default("#f59e0b")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    ChallengeMilestone[]
  entries       ChallengeEntry[]

  @@index([userId])
}

enum ChallengeType {
  NUMERIC       // Standard numeric challenge (100km, 30 days, etc.)
  WEEKLY_HABIT  // Weekly habit (3 days per week)
  MONTHLY_GOAL  // Monthly goal (once per month for X months)
  DAILY_GOAL    // Daily goal (check off each day, e.g., 10k steps daily)
}

model ChallengeMilestone {
  id          String   @id @default(cuid())
  name        String
  targetValue Float
  isReached   Boolean  @default(false)
  reachedAt   DateTime?

  // Relations
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  value       Float
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, date])
}

// ==================== GROUP CHALLENGES ====================

enum LinkedDataType {
  NONE          // Manual tracking only
  STEPS         // Link to StepsEntry
  SPORT         // Link to SportActivity
  HABIT         // Link to specific Habit
}

model GroupChallenge {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  challengeType ChallengeType  @default(NUMERIC)
  startDate     DateTime
  endDate       DateTime
  targetValue   Float
  unit          String         // e.g., "steps", "km", "sessions"
  weeklyTarget  Int?           // For WEEKLY_HABIT: number of days per week
  dailyTarget   Float?         // For DAILY_GOAL: daily target (e.g., 10000 steps)
  linkedType    LinkedDataType @default(NONE)
  linkedHabitId String?        // Optional: link to specific habit
  color         String         @default("#8b5cf6")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  creatorId     String
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members       GroupChallengeMember[]
  invitations   GroupChallengeInvitation[]
  messages      GroupChallengeMessage[]

  @@index([creatorId])
}

enum GroupChallengeMemberRole {
  CREATOR
  MEMBER
}

model GroupChallengeMember {
  id            String                   @id @default(cuid())
  role          GroupChallengeMemberRole @default(MEMBER)
  currentValue  Float                    @default(0)
  isCompleted   Boolean                  @default(false)
  joinedAt      DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Integration settings (per-member)
  linkedType        LinkedDataType @default(NONE)
  linkedHabitId     String?        // Link to specific habit
  minSteps          Int?           // For STEPS: minimum steps to count as completed
  sportActivityType String?        // For SPORT: type of activity (e.g., "running", "gym")
  minDuration       Int?           // For SPORT: minimum duration in minutes

  // Relations
  challengeId   String
  challenge     GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       GroupChallengeEntry[]

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

enum GroupChallengeInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model GroupChallengeInvitation {
  id          String                         @id @default(cuid())
  status      GroupChallengeInvitationStatus @default(PENDING)
  createdAt   DateTime                       @default(now())
  respondedAt DateTime?

  // Relations
  challengeId String
  challenge   GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, status])
}

model GroupChallengeEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  value       Float
  notes       String?
  createdAt   DateTime @default(now())

  // Additional metadata for statistics
  stepsCount    Int?     // Number of steps for STEPS integration
  duration      Int?     // Duration in minutes for SPORT/HABIT
  activityType  String?  // Type of activity for SPORT
  habitName     String?  // Name of habit for HABIT integration

  // Relations
  memberId    String
  member      GroupChallengeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([memberId, date])
}

model GroupChallengeMessage {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())

  // Relations
  challengeId String
  challenge   GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt])
  @@index([userId])
}

// ==================== GAMIFICATION ====================

model Gamification {
  id           String   @id @default(cuid())
  userId       String   @unique
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements UserAchievement[]
  rewards      UserReward[]
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String?
  xpReward    Int      @default(0)
  condition   Json     // Condition to unlock (flexible structure)
  createdAt   DateTime @default(now())

  // Relations
  users       UserAchievement[]
}

model UserAchievement {
  id             String   @id @default(cuid())
  unlockedAt     DateTime @default(now())

  // Relations
  gamificationId String
  gamification   Gamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)
  achievementId  String
  achievement    Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([gamificationId, achievementId])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  xpCost      Int
  icon        String?
  createdAt   DateTime @default(now())

  // Relations
  users       UserReward[]
}

model UserReward {
  id             String   @id @default(cuid())
  redeemedAt     DateTime @default(now())

  // Relations
  gamificationId String
  gamification   Gamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)
  rewardId       String
  reward         Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

// ==================== BACKLOG ====================

model BacklogItem {
  id            String        @id @default(cuid())
  content       String
  workspaceType WorkspaceType
  priority      Int           @default(0)
  isProcessed   Boolean       @default(false)
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceType, isProcessed])
}

// ==================== AI ====================

model AIConversation {
  id            String              @id @default(cuid())
  type          AIConversationType
  workspaceType WorkspaceType
  summary       String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  expiresAt     DateTime?           // Conversations expire after 5 days

  // Relations
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AIMessage[]

  @@index([userId, type])
  @@index([expiresAt])
}

enum AIConversationType {
  MORNING_ROUTINE
  PLANNING
  RETROSPECTIVE
  GENERAL
  BACKLOG_DISCUSSION
}

model AIMessage {
  id             String   @id @default(cuid())
  role           String   // "user" or "assistant"
  content        String   @db.Text
  contextSnapshot Json?   // Snapshot of context at message time
  createdAt      DateTime @default(now())

  // Relations
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIKnowledgeBase {
  id              String        @id @default(cuid())
  workspaceType   WorkspaceType // WORK or PRIVATE context
  personalInfo    String?       @db.Text // Personal info, fitness data, preferences
  companyInfo     String?       @db.Text // Company info for WORK workspace
  chatInstructions String?      @db.Text // Additional instructions per mode (JSON)
  systemPrompts   String?       @db.Text // Base system prompts per mode (JSON) - editable
  metaPrompt      String?       @db.Text // Global instructions read BEFORE everything else
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceType])
  @@index([userId])
}

// Knowledge Base - Encyklopedia firmowa / osobista
model KnowledgeCategory {
  id            String        @id @default(cuid())
  name          String
  description   String?
  color         String        @default("#6366f1")
  icon          String?
  workspaceType WorkspaceType
  isDefault     Boolean       @default(false) // Default categories cannot be deleted
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       KnowledgeEntry[]

  // Optional link to strategic category
  linkedCategoryId String?
  linkedCategory   Category?   @relation(fields: [linkedCategoryId], references: [id], onDelete: SetNull)

  // Nesting - parent category
  parentId      String?
  parent        KnowledgeCategory?  @relation("KnowledgeCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      KnowledgeCategory[] @relation("KnowledgeCategoryHierarchy")

  @@unique([userId, name, workspaceType])
  @@index([userId, workspaceType])
  @@index([parentId])
}

model KnowledgeEntry {
  id            String        @id @default(cuid())
  title         String
  content       String        @db.Text
  workspaceType WorkspaceType
  visibility    KnowledgeVisibility @default(PRIVATE) // PRIVATE = only me, TEAM = shared with team
  isImportant   Boolean       @default(false) // Highlighted entries
  lastUsedAt    DateTime?     // Track when AI last used this
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceType])
  @@index([categoryId])
  @@index([visibility])
}

// ==================== IDEAS (Rozkminki) ====================

model IdeaCategory {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#8b5cf6")
  emoji       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Team-owned category
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Link to strategic category (for auto-sync)
  linkedCategoryId String?
  linkedCategory   Category? @relation("LinkedIdeaCategories", fields: [linkedCategoryId], references: [id], onDelete: SetNull)

  ideas       Idea[]

  @@unique([organizationId, name])
  @@unique([organizationId, linkedCategoryId])
  @@index([organizationId])
  @@index([linkedCategoryId])
}

model Idea {
  id          String   @id @default(cuid())
  title       String?  // Optional title for forum-like posts
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    IdeaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  replies     IdeaReply[]

  @@index([categoryId])
  @@index([userId])
}

model IdeaReply {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([userId])
}

// ==================== SPORT ====================

model SportActivityType {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  color       String   @default("#3b82f6")
  isDefault   Boolean  @default(false) // Default types: siłownia, padel, basen, rower
  hasBodyParts Boolean @default(false) // Only gym has body parts
  createdAt   DateTime @default(now())

  // Relations
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  SportActivity[]

  @@index([userId])
}

model SportActivity {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  duration    Int?     // Duration in minutes
  notes       String?
  fromSteps   Boolean  @default(false) // If copied from steps
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeId      String
  type        SportActivityType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  bodyParts   SportBodyPart[]

  @@index([userId, date])
}

model SportBodyPart {
  id          String   @id @default(cuid())
  name        String   // klata, plecy, barki, biceps, triceps, pośladki, nogi, brzuch

  // Relations
  activityId  String
  activity    SportActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model StepsEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  count       Int      // Number of steps
  notes       String?
  copiedToActivity Boolean @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model FitnessGoal {
  id            String          @id @default(cuid())
  name          String
  description   String?         @db.Text
  goalType      FitnessGoalType
  targetValue   Float
  currentValue  Float           @default(0)
  unit          String          // kg, cm, reps, minutes, etc.
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  isCompleted   Boolean         @default(false)
  workspaceType WorkspaceType   @default(PRIVATE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId      String?
  period        Period?         @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceType])
  @@index([userId, startDate, endDate])
}

enum FitnessGoalType {
  WEIGHT_LOSS
  WEIGHT_GAIN
  MUSCLE_GAIN
  CARDIO_IMPROVEMENT
  STRENGTH_INCREASE
  FLEXIBILITY
  ENDURANCE
  BODY_FAT_REDUCTION
  CUSTOM
}

// ==================== ADMIN REPORTS ====================

model AdminReport {
  id          String          @id @default(cuid())
  content     String          @db.Text
  type        AdminReportType
  status      AdminReportStatus @default(NEW)
  adminNotes  String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}

enum AdminReportType {
  BUG
  FEATURE
  OTHER
}

enum AdminReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// ==================== ORGANIZATIONS (TEAMS) ====================

enum OrganizationRole {
  OWNER     // Admin/właściciel zespołu
  MEMBER    // Pracownik
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Sidebar configuration for team members
  // JSON array: [{ id: "backlog", enabled: true, order: 0 }, ...]
  sidebarConfig Json?

  // Relations
  ownerId     String
  owner       User     @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  categories  Category[] @relation("OrganizationCategories")
  tasks       Task[]     @relation("OrganizationTasks")
  messages    TeamMessage[]
  ideaCategories IdeaCategory[]

  @@index([ownerId])
}

model TeamMessage {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("TeamMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)

  // Assigned categories for this member
  assignedCategories OrganizationMemberCategory[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationMemberCategory {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  // Relations
  memberId   String
  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category           @relation("AssignedMemberCategories", fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([memberId, categoryId])
  @@index([memberId])
  @@index([categoryId])
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  TASK_DELETED        // Pracownik usunął zadanie
  TASK_COMPLETED      // Pracownik ukończył zadanie
  TASK_ASSIGNED       // Nowe zadanie przydzielone
  MEMBER_JOINED       // Nowy członek dołączył
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String           @db.Text
  isRead      Boolean          @default(false)
  metadata    Json?            // Additional data (taskId, memberId, etc.)
  createdAt   DateTime         @default(now())

  // Relations
  userId      String           // User who receives the notification
  user        User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==================== WEEKLY SCHEDULE BLOCKS ====================

model WeeklyScheduleBlock {
  id            String        @id @default(cuid())
  name          String
  description   String?
  dayOfWeek     Int           // 0=Monday, 1=Tuesday, ..., 6=Sunday
  startTime     String        // HH:mm format
  endTime       String        // HH:mm format
  color         String        @default("#6366f1")
  workspaceType WorkspaceType
  order         Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceType, dayOfWeek])
}

model DailyScheduleOverride {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  workspaceType WorkspaceType
  blocks        Json          // Array of block objects: { name, description, startTime, endTime, color, order }
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, workspaceType])
  @@index([userId, workspaceType, date])
}
